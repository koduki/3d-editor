{
  "name": "xr-acp-companion",
  "version": "0.3.0",
  "description": "XR-optimized AI agent control panel (ACP v1 client) for XREAL AURA (OST) and Meta Quest 3 (VST)",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:mock": "DEFAULT_AGENT=mock node server.mjs",
    "check": "node --check server.mjs scripts/mock-agent.mjs public/*.js",
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test test/bridge.test.mjs",
    "test:ui": "node --test test/ui-e2e.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
