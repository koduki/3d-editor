{
  "name": "xr-acp-workbench",
  "version": "0.4.0",
  "description": "Spatial Desktop IDE & ACP v1 AI Workbench engineered for XREAL AURA (Android XR / OST) and Meta Quest 3 (VST) with keyboard + mouse/trackpad",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:mock": "DEFAULT_AGENT=mock node server.mjs",
    "check": "node --check server.mjs lib/*.mjs scripts/mock-agent.mjs public/*.js",
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test test/bridge.test.mjs",
    "test:ui": "node --test test/ui-e2e.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
