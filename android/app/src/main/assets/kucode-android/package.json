{
  "name": "kucode-android",
  "displayName": "KuCode Android",
  "description": "Android project integration for KuCode's standard Linux toolchain and native host bridge.",
  "version": "0.1.0",
  "publisher": "koduki",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/settings.gradle",
    "workspaceContains:**/settings.gradle.kts"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "taskDefinitions": [
      {
        "type": "kucodeAndroid",
        "properties": {
          "task": {
            "type": "string",
            "description": "Gradle task name to execute through kucode build"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "kucodeAndroid.doctor",
        "title": "KuCode Android: SDK Doctor"
      },
      {
        "command": "kucodeAndroid.installSdk",
        "title": "KuCode Android: Install SDK Packages"
      },
      {
        "command": "kucodeAndroid.test",
        "title": "KuCode Android: Run Unit Tests"
      },
      {
        "command": "kucodeAndroid.gradleTask",
        "title": "KuCode Android: Run Gradle Task"
      },
      {
        "command": "kucodeAndroid.buildRun",
        "title": "KuCode Android: Build & Run"
      },
      {
        "command": "kucodeAndroid.install",
        "title": "KuCode Android: Install APK"
      },
      {
        "command": "kucodeAndroid.launch",
        "title": "KuCode Android: Launch App"
      },
      {
        "command": "kucodeAndroid.diagnostics",
        "title": "KuCode Android: Show Diagnostics"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kucodeAndroid.doctor",
          "when": "kucodeAndroid.project"
        },
        {
          "command": "kucodeAndroid.installSdk",
          "when": "kucodeAndroid.project"
        },
        {
          "command": "kucodeAndroid.test",
          "when": "kucodeAndroid.project"
        },
        {
          "command": "kucodeAndroid.gradleTask",
          "when": "kucodeAndroid.project"
        },
        {
          "command": "kucodeAndroid.buildRun",
          "when": "kucodeAndroid.project"
        },
        {
          "command": "kucodeAndroid.install",
          "when": "kucodeAndroid.project"
        },
        {
          "command": "kucodeAndroid.launch",
          "when": "kucodeAndroid.project"
        },
        {
          "command": "kucodeAndroid.diagnostics",
          "when": "kucodeAndroid.project"
        }
      ]
    }
  }
}
