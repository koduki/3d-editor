<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional spatial/audio features so the app works across Android XR glasses, headsets, and Android 15 Desktop Windowing -->
    <uses-feature android:name="android.software.xr.api.spatial" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.XrAcpWorkbench">

        <!-- Launch cleanly in Android XR Home Space alongside other spatial windows -->
        <property
            android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
            android:value="XR_ACTIVITY_START_MODE_HOME_SPACE" />

        <activity
            android:name=".WorkbenchActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="820dp"
                android:minWidth="480dp"
                android:minHeight="420dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Detached independent spatial panel (e.g. AI Agent or Console split off into a sibling XR window) -->
        <activity
            android:name=".SpatialPanelActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:windowSoftInputMode="adjustResize">
            <layout
                android:defaultWidth="520dp"
                android:defaultHeight="820dp"
                android:minWidth="360dp"
                android:minHeight="420dp" />
        </activity>

        <!-- Keeps ACP WebSocket & Console alive when focus moves to another XR spatial window -->
        <service
            android:name=".BridgeKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
